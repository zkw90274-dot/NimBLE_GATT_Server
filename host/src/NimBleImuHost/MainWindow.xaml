<Window x:Class="NimBleImuHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF" xmlns:views="clr-namespace:NimBleImuHost.Views"
        Title="NimBLE IMU Host" Height="760" Width="1180" MinHeight="620" MinWidth="960"
        Background="#F4F7F9" Foreground="#1F2933" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E3EAF0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <!-- The 3D view and the chart paint their own background; padding would only inset them. -->
    <Style x:Key="CanvasCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#7B8794"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#52606D"/>
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1F2933"/>
    </Style>
    <Style x:Key="HintText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#9AA5B1"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- The dotted focus rectangle outlives the click and reads as a rendering glitch. -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#10A594" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0C8B7D"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0A7468"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#C3CFD8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SoftButton" TargetType="Button">
      <Setter Property="Foreground" Value="#33475B"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="White" BorderBrush="#D9E2E8" BorderThickness="1"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F0F7F5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E1EFEB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#F1F4F6"/>
                <Setter Property="Foreground" Value="#9AA5B1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left panel -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,16,0">
        <TextBlock Text="NimBLE 姿态上位机" FontSize="20" FontWeight="SemiBold" Margin="2,0,0,14"/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="数据源" Style="{StaticResource SectionTitle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <RadioButton Content="仿真" IsChecked="{Binding UseSim}" Margin="0,0,14,0" GroupName="Mode"/>
              <RadioButton Content="真实 BLE" IsChecked="{Binding UseBle}" GroupName="Mode"/>
            </StackPanel>
            <TextBlock Text="{Binding ModeLabel, StringFormat=当前：{0}}" Style="{StaticResource LabelText}" Margin="0,0,0,10"/>

            <StackPanel Visibility="{Binding UseBle, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
              <Button Content="扫描设备" Command="{Binding ScanCommand}" Style="{StaticResource SoftButton}" Margin="0,0,0,8"/>
              <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Height="140"
                       Margin="0,0,0,8" BorderBrush="#D9E2E8">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}"/>
                      <TextBlock Text="{Binding Rssi, StringFormat=' ({0} dBm)'}" Style="{StaticResource HintText}" Margin="4,0,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="连接所选设备" Command="{Binding ConnectCommand}" Style="{StaticResource SoftButton}" Margin="0,0,0,10"/>
            </StackPanel>

            <Grid Visibility="{Binding UseSim, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="仿真速率 (Hz)" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
              <ComboBox Grid.Column="1" Margin="10,0,0,0" Padding="6,3"
                        ItemsSource="{Binding SimRateOptions}"
                        SelectedItem="{Binding SimRateHz}"
                        HorizontalAlignment="Stretch"/>
            </Grid>
          </StackPanel>
        </Border>

        <Button Content="{Binding RunButtonText}" Command="{Binding StartStopCommand}"
                Style="{StaticResource PrimaryButton}" Margin="0,0,0,12"/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="姿态角（度）" Style="{StaticResource SectionTitle}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
              </Grid.RowDefinitions>

              <!-- The dots tie each readout to its curve; hex must match EnsureSeries(). -->
              <Ellipse Grid.Row="0" Width="8" Height="8" Fill="#E4572E" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Ellipse Grid.Row="1" Width="8" Height="8" Fill="#2A9D8F" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Ellipse Grid.Row="2" Width="8" Height="8" Fill="#457B9D" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Ellipse Grid.Row="3" Width="8" Height="8" Fill="Transparent" Margin="0,0,8,0"/>

              <TextBlock Grid.Row="0" Grid.Column="1" Text="roll" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="pitch" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="yaw*" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="到达速率" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>

              <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Roll, StringFormat={}{0:+0.00;-0.00;0.00}}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Pitch, StringFormat={}{0:+0.00;-0.00;0.00}}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Yaw, StringFormat={}{0:+0.00;-0.00;0.00}}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding IngestHz, StringFormat={}{0:0.0} Hz}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="* yaw 相对上电，会漂移" Style="{StaticResource HintText}" Margin="16,8,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="流水线" Style="{StaticResource SectionTitle}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="26"/><RowDefinition Height="26"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="渲染" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="1" Text="丢帧" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RenderFps, StringFormat={}{0:0.0} fps}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Dropped}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="提示" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="绘图区右键：保存图片 / 自动缩放 / 在新窗口打开" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Right: 3D + chart -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="2*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource CanvasCard}" Margin="0,0,0,12">
        <views:Attitude3DView x:Name="AttitudeView"/>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource CanvasCard}">
        <ScottPlot:WpfPlot x:Name="Plot" />
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="14,9" Margin="0,12,0,0">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource LabelText}"/>
    </Border>
  </Grid>
</Window>
