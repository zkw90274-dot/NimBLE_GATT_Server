<Window x:Class="NimBleImuHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF" xmlns:views="clr-namespace:NimBleImuHost.Views"
        Title="NimBLE IMU Host" Height="720" Width="1100"
        Background="#12151A" Foreground="#E8EAED" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Left panel -->
    <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="NimBLE 姿态上位机" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="数据源" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <RadioButton Content="仿真" IsChecked="{Binding UseSim}" Margin="0,0,12,0" GroupName="Mode"/>
        <RadioButton Content="真实 BLE" IsChecked="{Binding UseBle}" GroupName="Mode"/>
      </StackPanel>
      <TextBlock Text="{Binding ModeLabel, StringFormat=当前：{0}}" Opacity="0.8" Margin="0,0,0,12"/>

      <StackPanel Visibility="{Binding UseBle, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
        <Button Content="扫描设备" Command="{Binding ScanCommand}" Margin="0,0,0,6" Padding="8,6"/>
        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Height="140" Margin="0,0,0,6">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}"/>
                <TextBlock Text="{Binding Rssi, StringFormat=' ({0} dBm)'}" Opacity="0.6"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="连接所选设备" Command="{Binding ConnectCommand}" Padding="8,6" Margin="0,0,0,8"/>
      </StackPanel>

      <Button Content="{Binding RunButtonText}" Command="{Binding StartStopCommand}" Padding="8,10" FontWeight="SemiBold" Margin="0,0,0,8"/>

      <Grid Visibility="{Binding UseSim, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="仿真速率 (Hz)" VerticalAlignment="Center" Opacity="0.8"/>
        <ComboBox Grid.Column="1" Margin="8,0,0,0" Padding="6,3"
                  ItemsSource="{Binding SimRateOptions}"
                  SelectedItem="{Binding SimRateHz}"
                  HorizontalAlignment="Stretch"/>
      </Grid>

      <Border Background="#1A1D23" CornerRadius="6" Padding="12">
        <StackPanel>
          <TextBlock Text="姿态角（度）" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="roll" Opacity="0.7"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Roll, StringFormat={}{0:+0.00;-0.00;0.00}}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="1" Text="pitch" Opacity="0.7"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Pitch, StringFormat={}{0:+0.00;-0.00;0.00}}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="2" Text="yaw*" Opacity="0.7"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Yaw, StringFormat={}{0:+0.00;-0.00;0.00}}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="3" Text="到达速率" Opacity="0.7"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IngestHz, StringFormat={}{0:0.0} Hz}" HorizontalAlignment="Right"/>
          </Grid>
          <TextBlock Text="* yaw 相对上电，会漂移" Opacity="0.5" FontSize="11" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border Background="#1A1D23" CornerRadius="6" Padding="12" Margin="0,8,0,0">
        <StackPanel>
          <TextBlock Text="流水线" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="渲染" Opacity="0.7"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RenderFps, StringFormat={}{0:0.0} fps}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Row="1" Text="丢帧" Opacity="0.7"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Dropped}" HorizontalAlignment="Right"/>
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.75" Margin="0,12,0,0"/>
    </StackPanel>
    </ScrollViewer>

    <!-- Right: 3D + chart -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="2*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <views:Attitude3DView x:Name="AttitudeView" Grid.Row="0" Margin="0,0,0,8"/>
      <Border Grid.Row="1" Background="#1A1D23" CornerRadius="6">
        <Grid>
          <ScottPlot:WpfPlot x:Name="Plot" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

