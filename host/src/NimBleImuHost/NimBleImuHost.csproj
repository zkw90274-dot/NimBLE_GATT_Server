<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinRT BLE projection (Windows.Devices.Bluetooth) requires the 10.0.x target platform -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>NimBleImuHost</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window.Icon needs the ico as a packed resource; ApplicationIcon alone only stamps the exe. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project exercise internal transform/settings helpers without widening the public API. -->
    <InternalsVisibleTo Include="NimBleImuHost.Tests" />
  </ItemGroup>

</Project>
