CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

CONFIG_BLINK_LED_GPIO=y
CONFIG_BLINK_GPIO=8

# ---- Flash and partitions ----
# The board carries a 16 MB flash. Note that raising only the flash size is not
# enough: the IDF default partition table hardcodes the factory app at 1 MB
# regardless, so the extra room stays unreachable until a custom table is
# selected. See partitions.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- IMU streaming rate ----
# Paces the BLE notifications only. The sensor itself is sampled on every
# data-ready interrupt (200 Hz) no matter what this says.
#
# The binding constraint is not this value but the connection interval
# requested in main/src/gap.c - a notification can only leave the device on a
# connection event. Ask for 15-30 ms there and this can go down to roughly the
# same order before the link, not the limiter, becomes the limit.
#
# Keep it a multiple of the 5 ms data-ready grid, otherwise the limiter
# quantises every interval up to the next edge (50 ms becomes 50/55 ms and the
# average rate comes out below the nominal one).
CONFIG_IMU_NOTIFY_PERIOD_MS=10

# Guided dynamic-accuracy test over the serial console. Turned on only while
# validating the AHRS; it delays boot by about a minute and floods the console.
CONFIG_IMU_DYNAMIC_TEST=y
